#Imports
#------------------
import ollama
import time


#Variables
#------------------
answer = []
prompts = []


#Subprograms
#------------------
#Feeds the model the prompts and generates a list with its responses
def feedModel(pPrompts,pAnswer):
    for item in pPrompts:
        response = ollama.chat(
            model='llama3.2',
            messages=[
                {
                    'role': 'user',
                    'content': item
                }
            ]
        )
        pAnswer.append(response['message']['content'])
    return pAnswer


#Filters through the responses and prints each prompt and response one at a time
def showResponse(prompts):
    index = 0
    for feedback in answer:
        print("\nPROMPT:")
        print(prompts[index])
        index += 1

        print("\nRESPONSE:")
        print(feedback)


#Main Code
#------------------
print("Hello! Welcome to the AI Security Lab, this functions as a robust way to test AI models.")
stop = input("Would you like to enter a prompt, ask the AI or Quit the program? (P/A/Q)")
stop = stop.upper()
while stop[0] != "Q":
    if stop[0] == "A":
        if prompts == []:
            print("You havent asked any questions.")
        else:
            print("Asking the model. Please wait.")
            answer = feedModel(prompts,answer)
            showResponse(prompts)
            prompts = []
    elif stop[0] != "P":
        print("That wasn't an option?")
        stop = input("Would you like to enter a prompt, ask the AI or Quit the program? (P/A/Q)")
        stop = stop.upper()
    else:
        userInput = input("enter a prompt: ")
        prompts.append(userInput)
        print(f"The prompt '{userInput}' was added to the prompt list.")
    stop = input("Would you like to enter a prompt, ask the AI or Quit the program? (P/A/Q)")
    stop = stop.upper()

